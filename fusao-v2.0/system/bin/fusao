#!/system/bin/sh
# fusao CLI — controle único do módulo.
# Uso: fusao profile [battery|balanced|game] | fusao framework [on|off|game|balanced|battery|idle]
#      fusao perf [on|off] | fusao fusaod [on|off] | fusao dnd [on|off]
#      fusao fas [on|off|status|mode <powersave|balance|performance|fast>|target <pkg> <auto|off|30,45,60>|gen|list]
#      fusao preload [on|off|prepare [pkg|all]|now [pkg|all]|record [pkg] [s]|status]
#      fusao display [show|720p|810p|900p|reset]
#      fusao gamelist [list|add <pkg>|del <pkg>|count|eligible|set <pkg>...]
#      fusao gos [on|off] | fusao reseed-stock
#      fusao status [quick] | fusao log | fusao bugreport | fusao kill-switch [on|off]
M54_DIR=${M54_DIR:-/data/adb/fusao}
MODDIR_FUSAO=/data/adb/modules/encore/fusao
[ -d "$M54_DIR" ] || M54_DIR="$MODDIR_FUSAO"
R="${FS_ROOT:-}"
DATA_ROOT="${PRELOAD_DATA_ROOT:-$R}"

log_msg() {
  echo "$(date '+%H:%M:%S' 2>/dev/null) $*" >> "$M54_DIR/fusao.log" 2>/dev/null
}

uptime_sec() {
  local _u _r
  if [ -r /proc/uptime ]; then
    read -r _u _r < /proc/uptime 2>/dev/null
    echo "${_u%%.*}"
  else
    date +%s 2>/dev/null || echo 0
  fi
}

find_fusaod() {
  local _b
  _b=$(command -v fusaod 2>/dev/null)
  [ -n "$_b" ] && [ -x "$_b" ] && { echo "$_b"; return 0; }
  for _b in /system/bin/fusaod /data/adb/modules/fusao/system/bin/fusaod /data/adb/modules/encore/system/bin/fusaod "$M54_DIR/../system/bin/fusaod"; do
    [ -x "$_b" ] && { echo "$_b"; return 0; }
  done
  return 1
}

# Restauração do stock.snapshot: implementação única no lib.sh (subshell: o CLI não herda umask/log da lib).
# unset -f antes do source: um lib.sh antigo, sem a função, não pode fazer este wrapper chamar a si mesmo
# (recursão de subshells); sem a função depois do source, falha explícita.
restore_snapshot_nodes() {
  (
    unset -f restore_snapshot_nodes
    [ -f "$M54_DIR/lib.sh" ] && . "$M54_DIR/lib.sh" 2>/dev/null
    command -v restore_snapshot_nodes >/dev/null 2>&1 || {
      echo "fusao: $M54_DIR/lib.sh sem restore_snapshot_nodes (lib incompatível com o CLI); stock NÃO restaurado" >&2
      exit 1
    }
    restore_snapshot_nodes
  )
}

# Perfil EM VIGOR = effective_profile do lib.sh (SSOT: battery + jogo da gamelist = game; balanced fica
# balanced). Subshell: o CLI não carrega a lib, só pergunta a regra a ela.
effective_profile() {
  ( . "$M54_DIR/lib.sh" 2>/dev/null && effective_profile ) || { tr -d '[:space:]' < "$M54_DIR/profile" 2>/dev/null || echo balanced; }
}

sync_fusaod_for_profile() {
  local _prof="$1" _ga _b _p
  [ -n "$FAKE_SETTINGS_DIR" ] && return 0
  _ga=$(cat "$M54_DIR/game-active.txt" 2>/dev/null | tr -d '[:space:]')
  # FAS ligado = fas-rs dono da CPU no jogo; o fusaod escreve piso de CPU e brigaria com ele
  if [ -f "$M54_DIR/fusaod.enabled" ] && [ ! -f "$M54_DIR/fas.enabled" ] && [ ! -f "$M54_DIR/disable" ] && [ -n "$_ga" ] && [ "$_prof" != "battery" ]; then
    if ! pgrep -f "[f]usaod serve" >/dev/null 2>&1; then
      _b=$(find_fusaod)
      if [ -n "$_b" ] && [ -d /sys/kernel/gpu ]; then
        nohup "$_b" serve >>"$M54_DIR/fusaod.log" 2>&1 &
      fi
    fi
  else
    for _p in $(pgrep -f "[f]usaod serve" 2>/dev/null); do
      [ "$_p" = "$$" ] || kill -TERM "$_p" 2>/dev/null
    done
  fi
}

# --- Subsistema de Preload baseado em gamelist.txt ---
pkg_has_data() {
  local _pkg="$1"
  [ -z "$_pkg" ] && return 1
  if [ -d "$DATA_ROOT/data/data/$_pkg" ] || \
     [ -d "$DATA_ROOT/data/media/0/Android/data/$_pkg" ] || \
     [ -d "$DATA_ROOT/data/media/0/Android/obb/$_pkg" ] || \
     [ -d "$DATA_ROOT/media/0/Android/data/$_pkg" ] || \
     [ -d "$DATA_ROOT/media/0/Android/obb/$_pkg" ]; then
    return 0
  fi
  return 1
}

list_eligible_games() {
  if [ -n "$PRELOAD_ELIGIBLE_FAKE" ]; then
    for _p in $PRELOAD_ELIGIBLE_FAKE; do echo "$_p"; done
    return 0
  fi
  [ -f "$M54_DIR/gamelist.txt" ] || return 0
  local _line
  while IFS= read -r _line || [ -n "$_line" ]; do
    # só builtins: printf|tr por linha custava 17 s de parede e 29 s de CPU com os 533 jogos (aparelho 2026-10-22).
    # Bordas (espaço, tab, CR) saem por expansão; espaço INTERNO cai no tr de sempre, que junta os pedaços
    # ("com.a.b # jogo" -> "com.a.b#jogo"): mesma saída de antes para qualquer linha.
    _line=${_line#"${_line%%[![:space:]]*}"}
    _line=${_line%"${_line##*[![:space:]]}"}
    case "$_line" in *[[:space:]]*) _line=$(printf "%s" "$_line" | tr -d '[:space:]');; esac
    case "$_line" in ""|\#*) continue;; esac
    if pkg_has_data "$_line"; then
      echo "$_line"
    fi
  done < "$M54_DIR/gamelist.txt"
}

sanitize_pkg() {
  printf "%s" "$1" | tr '.' '_' | tr -cd 'a-zA-Z0-9_-'
}

write_preload_state() {
  local _st="$1" _act="$2" _res="$3"
  {
    echo "preload_state=$_st"
    echo "last_action=$_act"
    echo "last_result=$_res"
    echo "updated_ts=$(uptime_sec)"
  } > "$M54_DIR/preload.state.tmp" 2>/dev/null && mv -f "$M54_DIR/preload.state.tmp" "$M54_DIR/preload.state" 2>/dev/null
}

read_mem_avail_kb() {
  if [ -n "$PRELOAD_MEM_AVAIL_KB" ]; then
    echo "$PRELOAD_MEM_AVAIL_KB"
    return 0
  fi
  local _memf="${R}/proc/meminfo"
  [ -r "$_memf" ] || _memf="/proc/meminfo"
  local _av
  _av=$(awk '/^MemAvailable:/{print $2}' "$_memf" 2>/dev/null)
  case "$_av" in ''|*[!0-9]*) echo 4000000;; *) echo "$_av";; esac
}

prepare_pack_one() {
  local _pkg="$1" _sec="${2:-1}" _san _pack _b _out _seen=0 _wrote=0 _d _f _sz _mt
  [ -z "$_pkg" ] && return 1
  if [ -f "$M54_DIR/gamelist.txt" ] && ! grep -Fxq "$_pkg" "$M54_DIR/gamelist.txt" 2>/dev/null; then
    echo "preload-prepare erro: $_pkg fora da gamelist" >&2
    return 1
  fi
  mkdir -p "$M54_DIR/preload" 2>/dev/null
  _san=$(sanitize_pkg "$_pkg")
  _pack="$M54_DIR/preload/${_san}.pack"
  _b=$(find_fusaod)
  if [ -n "$_b" ] && [ -z "$DATA_ROOT" ]; then
    _out=$(FUSAO_PACK_BASE="$M54_DIR" "$_b" preload-record "$_pkg" "$_sec" 2>&1)
    if [ $? -eq 0 ] && [ -s "$_pack" ]; then
      echo "$_out"
      log_msg "$_out"
      return 0
    fi
  elif [ -n "$_b" ] && [ -n "$DATA_ROOT" ]; then
    _out=$(FUSAO_PACK_BASE="$M54_DIR" "$_b" preload-record "$_pkg" "$_sec" "$DATA_ROOT" 2>&1)
    if [ $? -eq 0 ] && [ -s "$_pack" ]; then
      echo "$_out"
      log_msg "$_out"
      return 0
    fi
  fi

  # Fallback walk determinístico (mesmo formato <mtime> <size> <path> do fusaod)
  : > "${_pack}.tmp"
  for _d in \
    "$DATA_ROOT/data/data/$_pkg" \
    "$DATA_ROOT/data/media/0/Android/data/$_pkg" \
    "$DATA_ROOT/data/media/0/Android/obb/$_pkg" \
    "$DATA_ROOT/media/0/Android/data/$_pkg" \
    "$DATA_ROOT/media/0/Android/obb/$_pkg"; do
    [ -d "$_d" ] || continue
    for _f in $(find "$_d" -type f 2>/dev/null | head -n 500); do
      case "$_f" in */cache/*|*/code_cache/*|*.log|*.tmp) continue;; esac
      _seen=$((_seen + 1))
      _sz=$(wc -c < "$_f" 2>/dev/null | tr -d '[:space:]')
      case "$_sz" in ''|0|*[!0-9]*) continue;; esac
      [ "$_sz" -gt 536870912 ] 2>/dev/null && continue
      _mt=$(stat -c %Y "$_f" 2>/dev/null || stat -f %m "$_f" 2>/dev/null || echo 1)
      printf "%s %s %s\n" "$_mt" "$_sz" "$_f" >> "${_pack}.tmp"
      _wrote=$((_wrote + 1))
      [ "$_wrote" -ge 2000 ] && break
    done
  done
  if [ "$_wrote" -gt 0 ]; then
    mv -f "${_pack}.tmp" "$_pack" 2>/dev/null
    _out="preload-record ok pkg=$_pkg seen=$_seen wrote=$_wrote modo=walk"
    echo "$_out"
    log_msg "$_out"
    return 0
  fi
  rm -f "${_pack}.tmp" 2>/dev/null
  return 1
}

run_preload_one() {
  local _pkg="$1" _force="${2:-0}" _san _pack _b _out _now _lp _lts _lfiles _lbytes
  [ -z "$_pkg" ] && return 1
  if [ -f "$M54_DIR/gamelist.txt" ] && ! grep -Fxq "$_pkg" "$M54_DIR/gamelist.txt" 2>/dev/null; then
    echo "preload falhou: $_pkg fora da gamelist"
    return 1
  fi
  local _avail
  _avail=$(read_mem_avail_kb)
  if [ "$_avail" -lt 800000 ] 2>/dev/null; then
    _out="preload skip pkg=$_pkg reason=low_ram avail=${_avail}kB"
    echo "$_out"
    log_msg "$_out"
    write_preload_state "failed" "now" "ram_insuficiente (${_avail}kB)"
    return 2
  fi

  _now=$(uptime_sec)
  if [ "$_force" != "1" ] && [ -f "$M54_DIR/preload.last" ]; then
    while read -r _lp _lts _lfiles _lbytes; do
      if [ "$_lp" = "$_pkg" ]; then
        case "$_lts" in ''|*[!0-9]*) continue;; esac
        if [ $((_now - _lts)) -ge 0 ] && [ $((_now - _lts)) -lt "${PRELOAD_COOLDOWN:-60}" ]; then
          _out="preload ok pkg=$_pkg files=${_lfiles:-0} bytes=${_lbytes:-0} ms=0 (warm)"
          echo "$_out"
          write_preload_state "executed" "now" "$_pkg (warm files=${_lfiles:-0})"
          return 0
        fi
      fi
    done < "$M54_DIR/preload.last"
  fi

  _san=$(sanitize_pkg "$_pkg")
  _pack="$M54_DIR/preload/${_san}.pack"
  if [ ! -s "$_pack" ]; then
    prepare_pack_one "$_pkg" 1 >/dev/null 2>&1
  fi

  _b=$(find_fusaod)
  if [ -n "$_b" ]; then
    if [ -n "$DATA_ROOT" ]; then
      _out=$(FUSAO_PACK_BASE="$M54_DIR" "$_b" preload "$_pkg" "$DATA_ROOT" 2>&1)
    else
      _out=$(FUSAO_PACK_BASE="$M54_DIR" "$_b" preload "$_pkg" 2>&1)
    fi
    if echo "$_out" | grep -q "^preload ok pkg="; then
      echo "$_out"
      log_msg "$_out"
      _lfiles=$(echo "$_out" | sed -n 's/.*files=\([0-9]*\).*/\1/p')
      _lbytes=$(echo "$_out" | sed -n 's/.*bytes=\([0-9]*\).*/\1/p')
      grep -Fv "$_pkg " "$M54_DIR/preload.last" 2>/dev/null > "$M54_DIR/preload.last.tmp" || true
      echo "$_pkg $_now ${_lfiles:-0} ${_lbytes:-0}" >> "$M54_DIR/preload.last.tmp"
      mv -f "$M54_DIR/preload.last.tmp" "$M54_DIR/preload.last" 2>/dev/null
      write_preload_state "executed" "now" "$_pkg (files=${_lfiles:-0} bytes=${_lbytes:-0})"
      return 0
    fi
  fi

  # Fallback de aquecimento via leitura de pack (orçamento máx 64 MB por pacote em shell)
  if [ -s "$_pack" ]; then
    local _files=0 _bytes=0 _mt _sz _fp _budget=67108864
    while read -r _mt _sz _fp; do
      [ -r "$_fp" ] || continue
      case "$_sz" in ''|*[!0-9]*) continue;; esac
      if [ $((_bytes + _sz)) -le "$_budget" ]; then
        dd if="$_fp" of=/dev/null bs=65536 count=64 >/dev/null 2>&1
        _files=$((_files + 1))
        _bytes=$((_bytes + _sz))
      fi
    done < "$_pack"
    if [ "$_files" -gt 0 ]; then
      _out="preload ok pkg=$_pkg files=$_files bytes=$_bytes ms=1"
      echo "$_out"
      log_msg "$_out"
      grep -Fv "$_pkg " "$M54_DIR/preload.last" 2>/dev/null > "$M54_DIR/preload.last.tmp" || true
      echo "$_pkg $_now $_files $_bytes" >> "$M54_DIR/preload.last.tmp"
      mv -f "$M54_DIR/preload.last.tmp" "$M54_DIR/preload.last" 2>/dev/null
      write_preload_state "executed" "now" "$_pkg (files=$_files bytes=$_bytes)"
      return 0
    fi
  fi

  return 1
}

cmd="$1"; arg="$2"
case "$cmd" in
  profile)
    case "$arg" in
      battery|balanced|game)
        printf "%s" "$arg" > "$M54_DIR/profile" 2>/dev/null
        grep -q "^profile=" "$M54_DIR/config" 2>/dev/null && {
          grep -v "^profile=" "$M54_DIR/config" > "$M54_DIR/config.tmp" 2>/dev/null
          mv -f "$M54_DIR/config.tmp" "$M54_DIR/config" 2>/dev/null
        }
        echo "profile=$arg" >> "$M54_DIR/config" 2>/dev/null

        # Perfil em vigor: escolher battery com jogo da gamelist em foco aplica game (volta a battery no exit)
        _eff=$(effective_profile)
        # Coordena fusaod ANTES de aplicar tune.sh para evitar disputa de escrita. Gate pelo ESCOLHIDO: o
        # fusaod lê o arquivo de perfil sozinho e com battery aplicaria os tetos de battery dele em jogo.
        sync_fusaod_for_profile "$arg"

        if [ -f "$M54_DIR/framework.enabled" ] && [ -f "$M54_DIR/framework.sh" ]; then
          M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/framework.sh" auto >/dev/null 2>&1
        elif [ -f "$M54_DIR/tune.sh" ]; then
          M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/tune.sh" auto >/dev/null 2>&1
        fi

        if [ -s "$M54_DIR/game-active.txt" ] && [ -f "$M54_DIR/perf.enabled" ] && [ -f "$M54_DIR/perf.sh" ]; then
          M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" PERF_NO_DELAY=1 sh "$M54_DIR/perf.sh" enter >/dev/null 2>&1
        fi

        echo "profile=$arg"
        echo "profile_effective=$_eff"
        if [ -f "$M54_DIR/profile.state" ]; then
          grep -E "^(profile_state|profile_verify|sysfs_summary|profile_mismatch|profile_external)=" "$M54_DIR/profile.state" 2>/dev/null
        fi
        ;;
      *)
        cat "$M54_DIR/profile" 2>/dev/null || echo balanced
        ;;
    esac;;
  framework)
    case "$arg" in
      on)
        touch "$M54_DIR/framework.enabled"
        if [ -f "$M54_DIR/framework.sh" ]; then
          M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/framework.sh" auto >/dev/null 2>&1
        fi
        echo "framework=on"
        ;;
      off)
        rm -f "$M54_DIR/framework.enabled"
        M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/framework.sh" idle 2>/dev/null
        echo "framework=off (reverted)"
        ;;
      game|balanced|battery|idle|auto)
        M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/framework.sh" "$arg"
        ;;
      *)
        [ -f "$M54_DIR/framework.enabled" ] && echo "framework=on" || echo "framework=off"
        ;;
    esac;;
  perf)
    case "$arg" in
      on)
        touch "$M54_DIR/perf.enabled"
        if [ -s "$M54_DIR/game-active.txt" ] && [ -f "$M54_DIR/perf.sh" ]; then
          M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/perf.sh" enter >/dev/null 2>&1
        fi
        echo "perf=on"
        ;;
      off)
        rm -f "$M54_DIR/perf.enabled"
        if [ -f "$M54_DIR/perf.sh" ]; then
          M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/perf.sh" exit >/dev/null 2>&1
        fi
        echo "perf=off"
        ;;
      *)
        [ -f "$M54_DIR/perf.enabled" ] && echo "perf=on" || echo "perf=off"
        ;;
    esac;;
  fusaod)
    case "$arg" in
      on)
        touch "$M54_DIR/fusaod.enabled"
        _prof=$(tr -d '[:space:]' < "$M54_DIR/profile" 2>/dev/null)
        sync_fusaod_for_profile "${_prof:-balanced}"
        echo "fusaod=on"
        ;;
      off)
        rm -f "$M54_DIR/fusaod.enabled"
        if [ -z "$FAKE_SETTINGS_DIR" ]; then
          for _p in $(pgrep -f "[f]usaod serve" 2>/dev/null); do
            [ "$_p" = "$$" ] || kill -TERM "$_p" 2>/dev/null
          done
          if [ -f "$M54_DIR/tune.sh" ]; then
            M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/tune.sh" auto >/dev/null 2>&1
          else
            restore_snapshot_nodes
          fi
        fi
        echo "fusaod=off"
        ;;
      *)
        [ -f "$M54_DIR/fusaod.enabled" ] && echo "fusaod=on" || echo "fusaod=off"
        ;;
    esac;;
  fas)
    _fas="$M54_DIR/fas.sh"
    _ga=$(tr -d '[:space:]' < "$M54_DIR/game-active.txt" 2>/dev/null)
    _prof=$(tr -d '[:space:]' < "$M54_DIR/profile" 2>/dev/null)
    case "$arg" in
      on)
        touch "$M54_DIR/fas.enabled"
        sync_fusaod_for_profile "${_prof:-balanced}"
        if [ -n "$_ga" ] && [ -f "$_fas" ]; then
          if M54_DIR="$M54_DIR" sh "$_fas" enter "$_ga" >/dev/null 2>&1; then
            echo "fas=on (jogo ativo: ligado agora)"
          else
            echo "fas=on (jogo ativo fora do FAS: alvo off, ou sem binário)"
          fi
        else
          echo "fas=on (armado: liga no próximo game-enter)"
        fi
        ;;
      off)
        rm -f "$M54_DIR/fas.enabled"
        [ -f "$_fas" ] && M54_DIR="$M54_DIR" sh "$_fas" exit >/dev/null 2>&1
        # o fas-rs sai com a CPU cravada: com jogo ativo o perfil em vigor volta a ser o dono
        if [ -n "$_ga" ] && [ -f "$M54_DIR/tune.sh" ]; then
          M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/tune.sh" auto >/dev/null 2>&1
        fi
        sync_fusaod_for_profile "${_prof:-balanced}"
        echo "fas=off"
        ;;
      mode|gen|list)
        M54_DIR="$M54_DIR" sh "$_fas" "$arg" "$3" "$4"
        ;;
      target)
        M54_DIR="$M54_DIR" sh "$_fas" target "$3" "$4" || exit 1
        # jogo em foco: off sai do FAS na hora e o perfil volta a escrever a CPU por último (o fas-rs sai com
        # min=max cravados); outro alvo põe o jogo no FAS (o fas.sh já republicou a lista p/ um fas-rs vivo)
        if [ -n "$_ga" ] && [ "$3" = "$_ga" ] && [ -f "$M54_DIR/fas.enabled" ] && [ -f "$_fas" ]; then
          if [ "$4" = off ]; then
            M54_DIR="$M54_DIR" sh "$_fas" exit >/dev/null 2>&1
            if [ -f "$M54_DIR/tune.sh" ]; then
              M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/tune.sh" auto >/dev/null 2>&1
            fi
          else
            M54_DIR="$M54_DIR" sh "$_fas" enter "$_ga" >/dev/null 2>&1 || :
          fi
        fi
        ;;
      status|"")
        M54_DIR="$M54_DIR" sh "$_fas" status
        ;;
      *)
        echo "uso: fusao fas [on|off|status|mode <powersave|balance|performance|fast>|target <pkg> <auto|off|30,45,60>|gen|list]"
        exit 1
        ;;
    esac;;
  dnd)
    case "$arg" in
      on)
        touch "$M54_DIR/dnd.enabled"
        _ga="$(cat "$M54_DIR/game-active.txt" 2>/dev/null | tr -d '[:space:]')"
        if [ -n "$_ga" ] && grep -Fxq "$_ga" "$M54_DIR/gamelist.txt" 2>/dev/null; then
          M54_DIR="$M54_DIR" sh "$M54_DIR/dnd.sh" on 2>/dev/null
          echo "dnd=on (jogo ativo: aplicado agora)"
        else
          echo "dnd=on (armado: liga no próximo game-enter)"
        fi;;
      off)
        rm -f "$M54_DIR/dnd.enabled"
        M54_DIR="$M54_DIR" sh "$M54_DIR/dnd.sh" off 2>/dev/null
        echo "dnd=off"
        ;;
      *)
        [ -f "$M54_DIR/dnd.enabled" ] && echo "dnd=on" || echo "dnd=off"
        ;;
    esac;;
  preload)
    case "$arg" in
      on)
        touch "$M54_DIR/preload.enabled"
        # Prepara packs automaticamente para os jogos elegíveis instalados caso ainda não haja packs
        _el=$(list_eligible_games)
        _prep_cnt=0
        if [ -n "$_el" ]; then
          for _ep in $_el; do
            _esan=$(sanitize_pkg "$_ep")
            if [ ! -s "$M54_DIR/preload/${_esan}.pack" ]; then
              prepare_pack_one "$_ep" 1 >/dev/null 2>&1 && _prep_cnt=$((_prep_cnt + 1))
            else
              _prep_cnt=$((_prep_cnt + 1))
            fi
          done
        fi
        if [ "$_prep_cnt" -gt 0 ]; then
          write_preload_state "prepared" "on" "packs prontos ($_prep_cnt elegíveis)"
        else
          write_preload_state "armed" "on" "habilitado (aguardando pacotes elegíveis)"
        fi
        echo "preload=on"
        ;;
      off)
        rm -f "$M54_DIR/preload.enabled"
        write_preload_state "disabled" "off" "desativado pelo usuário"
        echo "preload=off"
        ;;
      prepare)
        _target="${3:-all}"
        _ok_p=0
        _tot_p=0
        if [ "$_target" != "all" ] && [ -n "$_target" ]; then
          _tot_p=1
          prepare_pack_one "$_target" 1 && _ok_p=1
        else
          _ga=$(cat "$M54_DIR/game-active.txt" 2>/dev/null | tr -d '[:space:]')
          _list=$(list_eligible_games)
          [ -n "$_ga" ] && ! echo "$_list" | grep -Fxq "$_ga" 2>/dev/null && _list="$_ga $_list"
          for _ep in $_list; do
            [ -z "$_ep" ] && continue
            _tot_p=$((_tot_p + 1))
            prepare_pack_one "$_ep" 1 && _ok_p=$((_ok_p + 1))
          done
        fi
        if [ "$_ok_p" -gt 0 ]; then
          write_preload_state "prepared" "prepare" "${_ok_p}/${_tot_p} pacotes preparados"
          echo "preload-prepare ok prepared=${_ok_p}/${_tot_p}"
        else
          write_preload_state "failed" "prepare" "nenhum pacote elegível com dados encontrados"
          echo "preload-prepare falhou: nenhum pacote elegível com dados na gamelist"
          exit 1
        fi
        ;;
      now)
        _target="${3:-}"
        _ga=$(cat "$M54_DIR/game-active.txt" 2>/dev/null | tr -d '[:space:]')
        _ok_run=0
        _ran_any=0
        if [ -n "$_target" ] && [ "$_target" != "all" ]; then
          _ran_any=1
          run_preload_one "$_target" 1 && _ok_run=1
        elif [ -n "$_ga" ]; then
          _ran_any=1
          run_preload_one "$_ga" 0 && _ok_run=1
        else
          # Sem jogo em primeiro plano: usa os pacotes elegíveis instalados da gamelist.txt
          # (limite de até 3 pacotes por acionamento global p/ respeitar orçamento de RAM)
          for _ep in $(list_eligible_games | head -n 3); do
            [ -z "$_ep" ] && continue
            _ran_any=1
            run_preload_one "$_ep" 1
            _rc=$?
            [ "$_rc" -eq 0 ] && _ok_run=$((_ok_run + 1))
            [ "$_rc" -eq 2 ] && break
          done
        fi
        if [ "$_ok_run" -eq 0 ]; then
          if [ "$_ran_any" -eq 0 ]; then
            write_preload_state "failed" "now" "nenhum jogo elegível instalado na gamelist"
            echo "preload falhou: nenhum jogo elegível instalado na gamelist"
          else
            write_preload_state "failed" "now" "falha ao aquecer pacotes elegíveis"
            echo "preload falhou: não foi possível aquecer os dados dos pacotes elegíveis"
          fi
          exit 1
        fi
        ;;
      record)
        # Aceita: fusao preload record [pkg] [segundos] OU fusao preload record [segundos]
        _arg3="${3:-}"
        _arg4="${4:-}"
        _pkg_rec=""
        _sec_rec="20"
        case "$_arg3" in
          "" )
            _pkg_rec="$(cat "$M54_DIR/game-active.txt" 2>/dev/null | tr -d '[:space:]')"
            ;;
          *[!0-9]* )
            _pkg_rec="$_arg3"
            [ -n "$_arg4" ] && _sec_rec="$_arg4"
            ;;
          * )
            _sec_rec="$_arg3"
            _pkg_rec="$(cat "$M54_DIR/game-active.txt" 2>/dev/null | tr -d '[:space:]')"
            ;;
        esac
        if [ -n "$_pkg_rec" ] && [ "$_pkg_rec" != "all" ]; then
          if prepare_pack_one "$_pkg_rec" "$_sec_rec"; then
            write_preload_state "prepared" "record" "pack gravado p/ $_pkg_rec"
          else
            write_preload_state "failed" "record" "falha ao gravar pack p/ $_pkg_rec"
            echo "preload-record falhou: sem dados legíveis p/ $_pkg_rec"
            exit 1
          fi
        else
          # Sem jogo em foco: prepara packs de todos os jogos elegíveis instalados na gamelist.txt
          _ok_r=0
          for _ep in $(list_eligible_games); do
            [ -z "$_ep" ] && continue
            prepare_pack_one "$_ep" "$_sec_rec" && _ok_r=$((_ok_r + 1))
          done
          if [ "$_ok_r" -gt 0 ]; then
            write_preload_state "prepared" "record" "${_ok_r} packs gerados via gamelist"
          else
            write_preload_state "failed" "record" "nenhum jogo elegível instalado na gamelist"
            echo "preload-record falhou: nenhum jogo elegível instalado na gamelist"
            exit 1
          fi
        fi
        ;;
      status)
        [ -f "$M54_DIR/preload.enabled" ] && echo "preload=on" || echo "preload=off (game-enter não dispara)"
        _cnt=0
        if [ -d "$M54_DIR/preload" ]; then
          _cnt=$(ls "$M54_DIR/preload"/*.pack 2>/dev/null | wc -l | tr -d '[:space:]')
        fi
        _el_list=$(list_eligible_games | tr '\n' ',' | sed 's/,$//')
        _el_cnt=0
        [ -n "$_el_list" ] && _el_cnt=$(echo "$_el_list" | tr ',' '\n' | grep -c .)
        _pstate="disabled"
        if [ -f "$M54_DIR/preload.state" ]; then
          _pstate=$(grep "^preload_state=" "$M54_DIR/preload.state" 2>/dev/null | cut -d= -f2-)
        fi
        if [ ! -f "$M54_DIR/preload.enabled" ] && [ "$_pstate" != "executed" ] && [ "$_pstate" != "prepared" ] && [ "$_pstate" != "failed" ]; then
          _pstate="disabled"
        elif [ -f "$M54_DIR/preload.enabled" ] && { [ -z "$_pstate" ] || [ "$_pstate" = "disabled" ]; }; then
          [ "$_cnt" -gt 0 ] && _pstate="prepared" || _pstate="armed"
        fi
        _lres=$(grep "^last_result=" "$M54_DIR/preload.state" 2>/dev/null | cut -d= -f2-)
        echo "preload_state=${_pstate:-disabled}"
        echo "eligible_count=${_el_cnt:-0}"
        echo "eligible_pkgs=${_el_list}"
        echo "mem_avail_kb=$(read_mem_avail_kb)"
        [ -n "$_lres" ] && echo "last_result=$_lres"
        if [ "$_cnt" -gt 0 ]; then
          echo "packs: ${_cnt}"
          ls -l "$M54_DIR/preload" 2>/dev/null
        else
          echo "packs: nenhum (use 'fusao preload prepare' ou 'fusao preload record')"
        fi
        echo "--- último preload/record no log ---"
        { grep -E "preload ok|preload-record ok|preload-record: fanotify|preload skip|watch: hooks" "$M54_DIR/fusao.log.1" 2>/dev/null; grep -E "preload ok|preload-record ok|preload-record: fanotify|preload skip|watch: hooks" "$M54_DIR/fusao.log" 2>/dev/null; } | tail -n 5
        ;;
      *)
        [ -f "$M54_DIR/preload.enabled" ] && echo "preload=on" || echo "preload=off"
        ;;
    esac;;
  ramclean)
    case "$arg" in
      # 2.12.0: sem gancho no game-enter (drop_caches no launch faz o jogo reler do disco o que estava em RAM e
      # a compactação síncrona trava junto); a limpeza fica só manual, fora do jogo
      on) rm -f "$M54_DIR/ramclean.enabled"; echo "ramclean=off (saiu do game-enter na 2.12.0: trava o carregamento; use fusao ramclean now)";;
      off) rm -f "$M54_DIR/ramclean.enabled"; echo "ramclean=off";;
      now)
        _rf0=$(awk '/^MemFree:/{print $2}' /proc/meminfo 2>/dev/null)
        sync 2>/dev/null
        echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
        _rc1=$?
        echo 1 > /proc/sys/vm/compact_memory 2>/dev/null
        _rc2=$?
        _rf1=$(awk '/^MemFree:/{print $2}' /proc/meminfo 2>/dev/null)
        _ra1=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null)
        echo "ramclean ok free=${_rf0}->${_rf1} avail=${_ra1} rc=${_rc1}/${_rc2}"
        ;;
      status)
        [ -f "$M54_DIR/ramclean.enabled" ] && echo "ramclean=on" || echo "ramclean=off (só manual: game-enter não limpa)"
        echo "--- último ramclean no log ---"
        { grep "ramclean ok" "$M54_DIR/fusao.log.1" 2>/dev/null; grep "ramclean ok" "$M54_DIR/fusao.log" 2>/dev/null; } | tail -n 5
        ;;
      *) [ -f "$M54_DIR/ramclean.enabled" ] && echo "ramclean=on" || echo "ramclean=off";;
    esac;;
  display)
    M54_DIR="$M54_DIR" sh "$M54_DIR/display.sh" "${arg:-show}";;
  gos)
    case "$arg" in
      on) rm -f "$M54_DIR/gos_killer.paused"; echo "gos=on (killer ativo)";;
      off) : > "$M54_DIR/gos_killer.paused"; echo "gos=off (killer pausado)";;
      *) [ -f "$M54_DIR/gos_killer.paused" ] && echo "gos=off" || echo "gos=on";;
    esac;;
  reseed-stock)
    {
      echo "# stock.snapshot reseeded $(date 2>/dev/null)"
      echo "/sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 533000"
      echo "/sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 533000"
      echo "/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2002000"
      echo "/sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2400000"
      echo "/sys/kernel/gpu/gpu_min_clock 221000"
      echo "/sys/kernel/gpu/gpu_max_clock 949000"
      echo "/sys/class/devfreq/17000010.devfreq_mif/min_freq 421000"
      echo "/sys/class/devfreq/17000010.devfreq_mif/max_freq 2093000"
      echo "/sys/class/devfreq/17000020.devfreq_int/min_freq 50000"
      echo "/sys/class/devfreq/17000020.devfreq_int/max_freq 666000"
      echo "/sys/class/devfreq/17000040.devfreq_disp/min_freq 66000"
      echo "/sys/class/devfreq/17000040.devfreq_disp/max_freq 666000"
      echo "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor energy_aware"
    } > "$M54_DIR/stock.snapshot" 2>/dev/null
    chmod 0600 "$M54_DIR/stock.snapshot" 2>/dev/null
    echo "reseed-stock ok (13 entradas)";;
  status)
    _cur_prof=$(cat "$M54_DIR/profile" 2>/dev/null | tr -d '[:space:]')
    [ -z "$_cur_prof" ] && _cur_prof="balanced"
    # confere o perfil EM VIGOR (battery em jogo = game), não o escolhido: senão em jogo daria partial falso.
    # `status quick` pula a conferência e mostra o último profile.state: o app usa depois de uma ação que já
    # conferiu (perfil, framework on, fusaod) ou que não mexe no perfil; abrir/atualizar seguem com a completa.
    if [ "$arg" != quick ] && [ -f "$M54_DIR/tune.sh" ]; then
      M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/tune.sh" verify >/dev/null 2>&1
    fi
    echo "profile=$_cur_prof"
    echo "profile_effective=$(effective_profile)"
    if [ -f "$M54_DIR/profile.state" ]; then
      grep -E "^(profile_state|profile_verify|sysfs_summary|profile_mismatch|profile_external)=" "$M54_DIR/profile.state" 2>/dev/null
    else
      echo "profile_state=applied"
      echo "profile_verify=0/0"
    fi
    echo "game-active=$(cat "$M54_DIR/game-active.txt" 2>/dev/null)"
    [ -f "$M54_DIR/fusaod.enabled" ] && echo "fusaod=on" || echo "fusaod=off"
    [ -f "$M54_DIR/framework.enabled" ] && echo "framework=on" || echo "framework=off"
    [ -f "$M54_DIR/perf.enabled" ] && echo "perf=on" || echo "perf=off"
    [ -f "$M54_DIR/dnd.enabled" ] && echo "dnd=on" || echo "dnd=off"
    [ -f "$M54_DIR/preload.enabled" ] && echo "preload=on" || echo "preload=off"
    [ -f "$M54_DIR/ramclean.enabled" ] && echo "ramclean=on" || echo "ramclean=off"
    [ -f "$M54_DIR/gos_killer.paused" ] && echo "gos=off" || echo "gos=on"
    if [ -f "$M54_DIR/fas.sh" ]; then
      M54_DIR="$M54_DIR" sh "$M54_DIR/fas.sh" status 2>/dev/null
    else
      [ -f "$M54_DIR/fas.enabled" ] && echo "fas=on" || echo "fas=off"
    fi
    echo "display=$(M54_DIR="$M54_DIR" sh "$M54_DIR/display.sh" show 2>/dev/null)"
    echo "thermal=$(grep -E '^thermal=' "$M54_DIR/config" 2>/dev/null | tail -1 | cut -d= -f2-)"
    echo "--- última atividade dos ganchos (foi ou não) ---"
    { grep -E "watch: (enter|exit|hooks)|framework: (apply|restore)|tune: (apply|restore)|perf: (io|proc)|dnd: (on|off)|preload ok|preload-record ok|ramclean ok" "$M54_DIR/fusao.log.1" 2>/dev/null; grep -E "watch: (enter|exit|hooks)|framework: (apply|restore)|tune: (apply|restore)|perf: (io|proc)|dnd: (on|off)|preload ok|preload-record ok|ramclean ok" "$M54_DIR/fusao.log" 2>/dev/null; } | tail -n 8
    pgrep -f "[f]usaod serve" >/dev/null 2>&1 && echo "fusaod=running" || echo "fusaod=stopped"
    pgrep -f "[w]atch.sh" >/dev/null 2>&1 && echo "watch=running" || echo "watch=stopped"
    pgrep -f "[f]usao.observer" >/dev/null 2>&1 && echo "observer=running" || echo "observer=stopped"
    ;;
  log)
    { cat "$M54_DIR/fusao.log.1" 2>/dev/null; cat "$M54_DIR/fusao.log" 2>/dev/null; } | tail -100
    ;;
  bugreport) M54_DIR="$M54_DIR" sh "$M54_DIR/bugreport.sh";;
  kill-switch)
    case "$arg" in
      on)
        touch "$M54_DIR/disable"
        if [ -z "$FAKE_SETTINGS_DIR" ]; then
          for _pat in "[f]usaod serve" "[f]usao.observer" "[w]atch.sh" "[t]hermal_guard.sh" "[g]os_killer" "[f]as-rs run"; do
            for _p in $(pgrep -f "$_pat" 2>/dev/null); do
              [ "$_p" = "$$" ] || kill -TERM "$_p" 2>/dev/null
            done
          done
          if [ -f "$M54_DIR/framework.sh" ]; then
            M54_DIR="$M54_DIR" FS_ROOT="$FS_ROOT" sh "$M54_DIR/framework.sh" idle >/dev/null 2>&1
          fi
          restore_snapshot_nodes
        fi
        echo "kill-switch=on (tudo parado no boot)"
        ;;
      off) rm -f "$M54_DIR/disable"; echo "kill-switch=off";;
      *) [ -f "$M54_DIR/disable" ] && echo "kill-switch=on" || echo "kill-switch=off";;
    esac;;
  gamelist)
    case "$arg" in
      list|"") cat "$M54_DIR/gamelist.txt" 2>/dev/null;;
      eligible) list_eligible_games;;
      count) wc -l < "$M54_DIR/gamelist.txt" 2>/dev/null | tr -d '[:space:]'; echo "";;
      add) [ -n "$3" ] && { grep -Fxq "$3" "$M54_DIR/gamelist.txt" 2>/dev/null || echo "$3" >> "$M54_DIR/gamelist.txt"; echo "added $3"; };;
      del) [ -n "$3" ] && { grep -Fxv "$3" "$M54_DIR/gamelist.txt" 2>/dev/null > "$M54_DIR/gamelist.tmp"; [ $? -le 1 ] && mv -f "$M54_DIR/gamelist.tmp" "$M54_DIR/gamelist.txt"; echo "removed $3"; };;
      # substituir a lista exige o verbo: um verbo digitado errado não pode apagar a gamelist
      set) [ -n "$3" ] || { echo "uso: fusao gamelist set <pkg> [pkg...]" >&2; exit 1; }
        printf "%s\n" "$3" "$4" "$5" "$6" "$7" | grep -v "^$" > "$M54_DIR/gamelist.txt"; echo "gamelist substituida";;
      *) echo "fusao gamelist: verbo invalido '$arg' (list|add|del|count|eligible|set); lista intacta" >&2; exit 1;;
    esac;;
  *) echo "fusao: profile|framework|perf|fusaod|fas|dnd|preload|ramclean|display|gos|reseed-stock|status|log|bugreport|kill-switch|gamelist"; exit 1;;
esac
