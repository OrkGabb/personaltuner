<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Zero permissões: sem INTERNET, sem QUERY_ALL_PACKAGES. A lista de apps
         para a gamelist vem do intent LAUNCHER declarado abaixo (visibilidade
         de pacotes via <queries>, permitido desde a API 30). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FusaoApp"
        android:label="FUSAO"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
