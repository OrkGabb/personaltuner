 pub mod extra_policy;
+mod gpu_guard;
 mod process_monitor;
 
 use std::{
@@ -45,6 +46,7 @@ use crate::{
     file_handler::FileHandler,
 };
 use cpu_info::Info;
+use gpu_guard::GpuGuard;
 use extra_policy::ExtraPolicy;
 
 pub static EXTRA_POLICY_MAP: OnceLock<HashMap<i32, Mutex<ExtraPolicy>>> = OnceLock::new();
@@ -57,6 +59,7 @@ pub struct Controller {
     file_handler: FileHandler,
     process_monitor: ProcessMonitor,
     util_max: Option<f64>,
+    gpu_guard: GpuGuard,
 }
 
 impl Controller {
@@ -93,6 +96,7 @@ impl Controller {
             file_handler: FileHandler::new(),
             process_monitor: ProcessMonitor::new(),
             util_max: None,
+            gpu_guard: GpuGuard::new(),
         })
     }
 
@@ -157,6 +161,11 @@ impl Controller {
     }
 
     pub fn fas_update_freq(&mut self, control: isize, is_janked: bool) {
+        let (control, is_janked) = if self.gpu_guard.saturated() {
+            (control.min(0), false)
+        } else {
+            (control, is_janked)
+        };
         #[cfg(debug_assertions)]
         debug!("change freq: {control}");
 
