From c9cf12472a1e4ee595212edbeaf5f74e7f4ee45c Mon Sep 17 00:00:00 2001
From: OrkGabb <ork@Gabriel.localdomain>
Date: Tue, 20 Oct 2026 18:32:11 -0300
Subject: [PATCH 5/9] cpu_common: GPU guard holds only at the GPU ceiling, with
 hysteresis; never during a stall

---
 src/cpu_common/gpu_guard.rs           | 33 ++++++++++++++++++++++++---
 src/cpu_common/mod.rs                 |  5 ++--
 src/framework/scheduler/looper/mod.rs | 13 +++++++----
 3 files changed, 42 insertions(+), 9 deletions(-)

diff --git a/src/cpu_common/gpu_guard.rs b/src/cpu_common/gpu_guard.rs
index dda98d4..a1de9e3 100644
--- a/src/cpu_common/gpu_guard.rs
+++ b/src/cpu_common/gpu_guard.rs
@@ -24,14 +24,23 @@ use log::info;
 
 // Mali on Exynos reports the GPU load as " 47%"; a missing node (other SoCs) means no guard.
 const GPU_BUSY_PATH: &str = "/sys/kernel/gpu/gpu_busy";
+const GPU_CLOCK_PATH: &str = "/sys/kernel/gpu/gpu_clock";
+const GPU_MAX_CLOCK_PATH: &str = "/sys/kernel/gpu/gpu_max_clock";
 const SATURATED_PCT: u32 = 95;
+const RELEASE_PCT: u32 = 85;
+// consecutive saturated samples before holding (500 ms)
+const HOLD_AFTER: u8 = 2;
 const SAMPLE_EVERY: Duration = Duration::from_millis(250);
 
 /// With the GPU saturated, a frame below target is GPU time: boosting the CPU only burns power
 /// (M54, Bleach on max graphics: GPU 949 MHz at 99%, fas-rs pushed the A78 to 2.4 GHz for 0 fps).
+/// Saturated = busy AND already at its ceiling (gpu_max_clock, which thermal lowers): Mali DVFS
+/// keeps gpu_busy high at LOW clocks too, and busy alone held the CPU down in Roblox while the GPU
+/// had headroom (~120 flips in 2.5 min).
 #[derive(Debug)]
 pub struct GpuGuard {
     saturated: bool,
+    streak: u8,
     last_sample: Instant,
 }
 
@@ -39,6 +48,7 @@ impl GpuGuard {
     pub fn new() -> Self {
         Self {
             saturated: false,
+            streak: 0,
             last_sample: Instant::now()
                 .checked_sub(SAMPLE_EVERY)
                 .unwrap_or_else(Instant::now),
@@ -48,7 +58,24 @@ impl GpuGuard {
     pub fn saturated(&mut self) -> bool {
         if self.last_sample.elapsed() >= SAMPLE_EVERY {
             self.last_sample = Instant::now();
-            let now = read_busy_pct().is_some_and(|pct| pct >= SATURATED_PCT);
+            let busy = read_u32(GPU_BUSY_PATH).unwrap_or(0);
+            let at_ceiling = match (read_u32(GPU_CLOCK_PATH), read_u32(GPU_MAX_CLOCK_PATH)) {
+                (Some(clock), Some(max)) => clock > 0 && clock >= max,
+                _ => false,
+            };
+            let now = if self.saturated {
+                at_ceiling && busy >= RELEASE_PCT
+            } else {
+                self.streak = if at_ceiling && busy >= SATURATED_PCT {
+                    self.streak.saturating_add(1)
+                } else {
+                    0
+                };
+                self.streak >= HOLD_AFTER
+            };
+            if !now {
+                self.streak = 0;
+            }
             if now != self.saturated {
                 info!(
                     "GPU guard: {}",
@@ -66,8 +93,8 @@ impl GpuGuard {
     }
 }
 
-fn read_busy_pct() -> Option<u32> {
-    fs::read_to_string(GPU_BUSY_PATH)
+fn read_u32(path: &str) -> Option<u32> {
+    fs::read_to_string(path)
         .ok()?
         .trim()
         .trim_end_matches('%')
diff --git a/src/cpu_common/mod.rs b/src/cpu_common/mod.rs
index cc5e210..95f4ba3 100644
--- a/src/cpu_common/mod.rs
+++ b/src/cpu_common/mod.rs
@@ -160,8 +160,9 @@ impl Controller {
         self.util_max = None;
     }
 
-    pub fn fas_update_freq(&mut self, control: isize, is_janked: bool) {
-        let (control, is_janked) = if self.gpu_guard.saturated() {
+    // stalled = no frame for >= 100 ms: boost as upstream does, the GPU guard never holds a frozen game
+    pub fn fas_update_freq(&mut self, control: isize, is_janked: bool, stalled: bool) {
+        let (control, is_janked) = if !stalled && self.gpu_guard.saturated() {
             (control.min(0), false)
         } else {
             (control, is_janked)
diff --git a/src/framework/scheduler/looper/mod.rs b/src/framework/scheduler/looper/mod.rs
index 0049a15..4016316 100644
--- a/src/framework/scheduler/looper/mod.rs
+++ b/src/framework/scheduler/looper/mod.rs
@@ -212,18 +212,23 @@ impl Looper {
             return;
         }
 
-        let (control, is_janked) = if let Some(buffer) = &self.fas_state.buffer {
+        let (control, is_janked, stalled) = if let Some(buffer) = &self.fas_state.buffer {
             let target_fps_offset = self
                 .therminal
                 .target_fps_offset(&mut self.config, self.fas_state.mode);
-            calculate_control(
+            let (control, is_janked) = calculate_control(
                 buffer,
                 &mut self.config,
                 self.fas_state.mode,
                 &mut self.controller_state,
                 target_fps_offset,
             )
-            .unwrap_or_default()
+            .unwrap_or_default();
+            (
+                control,
+                is_janked,
+                buffer.frametime_state.additional_frametime > Duration::ZERO,
+            )
         } else {
             return;
         };
@@ -233,7 +238,7 @@ impl Looper {
 
         self.controller_state
             .controller
-            .fas_update_freq(control, is_janked);
+            .fas_update_freq(control, is_janked, stalled);
 
         #[cfg(feature = "m54-trace")]
         self.trace(control, is_janked);
-- 
